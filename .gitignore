# ============================================================
# Fufu新闻 Git 忽略规则
# ============================================================

# 依赖目录
node_modules/
.venv/
__pycache__/
*.pyc

# 构建产物
.next/
dist/
*.tsbuildinfo

# IDE 配置
.vs/
.vscode/
.idea/

# 环境变量
.env
.env.local

# 数据库
*.db
*.db-shm
*.db-wal
*.sqlite

# 日志
*.log
logs/

# 操作系统
.DS_Store
Thumbs.db

# 智能体本地记忆
.workbuddy/

# HTML 分享工具的打包产物
.trae-html-share-packages/

# 上传的图片资源（例外：前端 public 下的静态图片与交付材料截图必须入库）
*.jpeg
*.png
!fufu-web/public/*.png
!fufu-web/public/*.jpeg
!交付材料/*.png
