# ============================================================
# fufu新闻 — 前端 Docker 镜像（生产模式）
# ============================================================
# 构建：docker build -f Dockerfile.frontend -t fufu-frontend .
# ============================================================

# ---- 阶段1：构建 ----
FROM node:20-alpine AS builder

WORKDIR /app

COPY fufu-web/package.json fufu-web/package-lock.json ./
RUN npm ci

COPY fufu-web/ .
RUN npm run build

# ---- 阶段2：运行 ----
FROM nginx:alpine

# 复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制 Nginx 配置（API 代理到后端）
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
