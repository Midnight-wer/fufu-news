# ============================================================
# fufu新闻 - 环境变量配置示例
# ============================================================
# 使用方法：
#   1. 复制此文件为 .env（即：cp .env.example .env）
#   2. 根据实际部署环境修改各项配置
#   3. 启动应用时自动读取 .env 文件中的配置
#
# 注意：.env 文件包含敏感信息（API Key 等），请不要提交到版本控制系统！
# ============================================================

# ---- 应用基本信息 ----
# 应用名称（显示在 Swagger/OpenAPI 文档中）
APP_NAME="fufu新闻"
# 应用版本号
APP_VERSION="1.0.0"

# ---- 数据库配置 ----
# SQLite 数据库文件路径（使用 aiosqlite 异步驱动）
# 格式：sqlite+aiosqlite:///数据库文件绝对路径
DATABASE_URL=sqlite+aiosqlite:///D:/fufu新闻/data/fufu.db

# ---- 安全配置 ----
# JWT 签名密钥——生产环境务必更换为随机字符串！
# 可使用命令生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string
# JWT 访问令牌过期时间（分钟），默认 10080 分钟 = 7 天
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 默认用户配置 ----
# 首次启动时自动创建的默认账号（生产环境建议修改）
DEFAULT_USERNAME=fufu
DEFAULT_PASSWORD=fufu123

# ---- AI 服务配置 ----
# AI 后端标识（如 deepseek / openai / ollama）
AI_BACKEND=deepseek
# AI API Key（必填！从对应平台获取）
#  - DeepSeek：https://platform.deepseek.com/api_keys
#  - OpenAI：https://platform.openai.com/api-keys
#  - Ollama 本地部署不需要 API Key
AI_API_KEY=sk-your-api-key-here
# AI API 请求地址（完整端点 URL）
#  - DeepSeek：https://api.deepseek.com/v1/chat/completions
#  - OpenAI：https://api.openai.com/v1/chat/completions
#  - Ollama 本地：http://localhost:11434/v1/chat/completions
AI_BASE_URL=https://api.deepseek.com/v1/chat/completions
# AI 模型名称
#  - DeepSeek：deepseek-chat / deepseek-reasoner
#  - OpenAI：gpt-4o / gpt-4o-mini
#  - Ollama：qwen2.5:7b / llama3 / gemma2
AI_MODEL=deepseek-chat
# AI 生成温度（0.0-1.0），越低输出越确定，越高越有创意
AI_TEMPERATURE=0.3
# 是否在抓取文章后自动生成 AI 摘要
AI_AUTO_SUMMARY=true
# 是否在抓取文章后自动生成 AI 标签
AI_AUTO_TAG=true
